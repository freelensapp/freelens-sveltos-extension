{
  "name": "@freelensapp/sveltos-extension",
  "version": "2.0.0-0",
  "description": "ProjectSveltos UI for Freelens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens-sveltos-extension.git",
    "directory": "."
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.6.3",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "biome:migrate": "pnpm biome migrate --write",
    "trunk": "pnpm dlx @trunkio/launcher@1.3.4",
    "trunk:check": "pnpm trunk check",
    "trunk:check:all": "pnpm trunk check --all",
    "trunk:fix": "pnpm trunk check --fix",
    "trunk:fix:all": "pnpm trunk check --fix --all",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "knip": "pnpm dlx knip@6.41.0 --dependencies --files --no-gitignore --no-config-hints",
    "knip:check": "pnpm \"/^knip:(development|production)\\$/\"",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "prebuild": "pnpm type:check",
    "build": "electron-vite build",
    "build:production": "VITE_PRESERVE_MODULES=false electron-vite build",
    "build:force": "electron-vite build",
    "bump-version": "pnpm version --no-commit-hooks --no-git-tag-version",
    "pack:dev": "pnpm bump-version prerelease && pnpm build:force && pnpm build && pnpm clean:tgz && pnpm pack && pnpm dlx shx@0.4.0 ls \"$PWD/*.tgz\"",
    "install:dev": "./scripts/install-freelens-extension.sh",
    "clean": "pnpm clean:out",
    "clean:dts": "pnpm dlx shx@0.4.0 rm -f \"src/**/*.d.scss.ts\"",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf out",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(dts|node_modules|out|tgz)\\$/\"",
    "postupdate": "pnpm biome:migrate"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@freelensapp/extensions": "^2.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "monaco-editor": "0.57.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass-embedded": "1.105.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "sveltos",
    "projectsveltos"
  ],
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
